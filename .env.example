# Supabase Configuration
# Get these values from the Supabase project settings > API
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: enable Sentry error reporting
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Integration tests (npm run test:integration) sign in as a real user so that
# RLS actually applies. Create a dedicated account in the Supabase dashboard --
# do not reuse a personal login, since these tests write and delete rows.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Demo account seeding (npm run seed:demo). Must NOT be in demo_accounts when
# the seed runs -- RLS would refuse every insert. Add it to demo_accounts after.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
