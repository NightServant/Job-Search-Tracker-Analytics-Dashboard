{
  "name": "job-search-tracker",
  "private": true,
  "version": "1.0.0",
  "homepage": "https://nightservant.github.io/Job-Search-Tracker-Analytics-Dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:gh-pages": "tsc -b && vite build --base=/Job-Search-Tracker-Analytics-Dashboard/ && node scripts/create-gh-pages-404.cjs",
    "predeploy": "npm run build:gh-pages",
    "deploy": "gh-pages -d dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "load:autofill": "npx artillery run load-tests/job-autofill.yml",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed:demo": "node --env-file=.env scripts/seed-demo.mjs",
    "dev:next": "next dev",
    "build:next": "next build",
    "start:next": "next start"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^10.51.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.51.0",
    "@tiptap/core": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "lucide-react": "^0.400.0",
    "next": "^15.5.23",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^6.24.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.6.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "axe-core": "^4.11.0",
    "eslint": "^9.6.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "gh-pages": "^6.3.0",
    "globals": "^15.8.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.39",
    "supabase": "^2.98.2",
    "tailwindcss": "^3.4.4",
    "typescript": "~5.5.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.3.3",
    "vitest": "^2.1.8"
  }
}
